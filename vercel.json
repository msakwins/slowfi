{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/verifications", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/(diagnostic|historique|confidentialite|application)",
      "destination": "/index.html"
    }
  ]
}
