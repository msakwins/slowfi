{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/verifications", "destination": "/", "permanent": true },
    { "source": "/en/verifications", "destination": "/en", "permanent": true }
  ]
}
